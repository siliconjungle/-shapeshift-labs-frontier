{
  "name": "@shapeshift-labs/frontier",
  "version": "0.1.5",
  "description": "Fast compact JSON diff and patch primitives for JavaScript values.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/siliconjungle/-shapeshift-labs-frontier.git"
  },
  "homepage": "https://github.com/siliconjungle/-shapeshift-labs-frontier#readme",
  "bugs": {
    "url": "https://github.com/siliconjungle/-shapeshift-labs-frontier/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./diff": {
      "types": "./dist/diff.d.ts",
      "import": "./dist/diff.js",
      "default": "./dist/diff.js"
    },
    "./apply": {
      "types": "./dist/apply.d.ts",
      "import": "./dist/apply.js",
      "default": "./dist/apply.js"
    },
    "./clone": {
      "types": "./dist/clone.d.ts",
      "import": "./dist/clone.js",
      "default": "./dist/clone.js"
    },
    "./constants": {
      "types": "./dist/constants.d.ts",
      "import": "./dist/constants.js",
      "default": "./dist/constants.js"
    },
    "./patch": {
      "types": "./dist/patch.d.ts",
      "import": "./dist/patch.js",
      "default": "./dist/patch.js"
    },
    "./pointer": {
      "types": "./dist/pointer.d.ts",
      "import": "./dist/pointer.js",
      "default": "./dist/pointer.js"
    },
    "./equal": {
      "types": "./dist/equal.d.ts",
      "import": "./dist/equal.js",
      "default": "./dist/equal.js"
    },
    "./unicode": {
      "types": "./dist/unicode.d.ts",
      "import": "./dist/unicode.js",
      "default": "./dist/unicode.js"
    },
    "./validate": {
      "types": "./dist/validate.d.ts",
      "import": "./dist/validate.js",
      "default": "./dist/validate.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "diff": [
        "./dist/diff.d.ts"
      ],
      "apply": [
        "./dist/apply.d.ts"
      ],
      "clone": [
        "./dist/clone.d.ts"
      ],
      "constants": [
        "./dist/constants.d.ts"
      ],
      "patch": [
        "./dist/patch.d.ts"
      ],
      "pointer": [
        "./dist/pointer.d.ts"
      ],
      "equal": [
        "./dist/equal.d.ts"
      ],
      "unicode": [
        "./dist/unicode.d.ts"
      ],
      "validate": [
        "./dist/validate.d.ts"
      ],
      "types": [
        "./dist/types.d.ts"
      ],
      "*": [
        "./dist/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "benchmarks/package-bench.mjs"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p test/tsconfig.json",
    "test": "npm run build && npm run typecheck && node test/smoke.mjs && node test/diff-core.mjs && node test/diff-fuzz.mjs --cases 1000",
    "fuzz": "npm run build && node test/diff-fuzz.mjs --cases 1000",
    "prepack": "npm run test",
    "bench": "npm run build && node benchmarks/package-bench.mjs",
    "pack:dry": "npm pack --dry-run"
  },
  "keywords": [
    "json",
    "diff",
    "patch",
    "delta",
    "rfc6902",
    "state"
  ],
  "devDependencies": {
    "typescript": "^6.0.3"
  },
  "author": "james addison"
}
